# ==============================================================================
# ABCD Enterprise HRMS, HCM & Payroll Platform Environment Variables
# Configured to align with Kafka (KRaft), PostgreSQL 16 & Splunk Docker Compose
# ==============================================================================

# PostgreSQL Credentials (Matching kafka-docker-image/docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Apache Kafka (KRaft Mode localhost:9092)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Splunk Enterprise Logging (HEC on 8088, Web UI on 8000, Forwarder on 9997)
SPLUNK_HEC_URL=http://localhost:8088/services/collector/event
SPLUNK_HEC_TOKEN=946654e2-6e83-4ae2-943a-a32ffef9305b
SPLUNK_INDEX=main
SPLUNK_ENABLED=true

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# Security & Cryptography
ABCD_SECURITY_JWT_SECRET=ABCD-ENTERPRISE-SUPER-SECRET-JWT-SIGNING-KEY-FOR-ABCD-HRMS-PLATFORM-2026-MUST-BE-64-BYTES!
ABCD_SECURITY_JWT_EXPIRATION_MINUTES=120
ABCD_SECURITY_ENCRYPTION_KEY=ABCD-ENTERPRISE-SECRET-KEY-32B!

# Mail Server (MailHog for local dev)
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025

# Service Ports:
# identity-service: 8081
# workforce-service: 8082
# time-leave-service: 8083
# onboarding-bgv-service: 8084
# payroll-service: 8089 (Kafka-UI is on 8085; payroll-service runs on 8089)
# tax-benefits-service: 8086
# payment-ledger-service: 8087
# notification-reporting-service: 8088
# abcd-hrms-ui: 4200
