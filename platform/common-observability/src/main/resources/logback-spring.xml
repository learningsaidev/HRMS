<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="abcd-service"/>
    <springProperty scope="context" name="splunkUrl" source="splunk.hec.url" defaultValue="http://localhost:8088/services/collector/event"/>
    <springProperty scope="context" name="splunkToken" source="splunk.hec.token" defaultValue="00000000-0000-0000-0000-000000000000"/>
    <springProperty scope="context" name="splunkIndex" source="splunk.hec.index" defaultValue="main"/>
    <springProperty scope="context" name="splunkEnabled" source="splunk.hec.enabled" defaultValue="true"/>

    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [${appName},%X{correlationId:-},%X{traceId:-}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Splunk HTTP Event Collector (HEC) Appender -->
    <appender name="SPLUNK" class="com.abcd.hrms.common.observability.splunk.SplunkHecAppender">
        <url>${splunkUrl}</url>
        <token>${splunkToken}</token>
        <source>${appName}</source>
        <sourcetype>_json</sourcetype>
        <index>${splunkIndex}</index>
        <enabled>${splunkEnabled}</enabled>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="SPLUNK"/>
    </root>

    <logger name="com.abcd.hrms" level="DEBUG"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.hibernate" level="INFO"/>

</configuration>
